{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/stability-ai",
    "description": "MCP server for Stability AI image generation, editing, and upscaling",
    "version": "1.0.1",
    "icons": [
        {
            "src": "https://raw.githubusercontent.com/andreasjhagen/Cynosure-MCPs/main/mcp-stability-ai/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/stability-ai",
            "version": "1.0.1",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "STABILITY_API_KEY",
                    "description": "Your Stability AI API key from https://platform.stability.ai/account/keys",
                    "isRequired": true,
                    "format": "string",
                    "isSecret": true
                },
                {
                    "name": "STABILITY_OUTPUT_DIR",
                    "description": "Directory to save generated images (defaults to an OS temp directory)",
                    "isRequired": false,
                    "format": "string",
                    "isSecret": false
                }
            ]
        }
    ],
    "repository": {
        "url": "https://github.com/andreasjhagen/Cynosure-MCPs",
        "source": "github",
        "subfolder": "mcp-stability-ai"
    }
}
